{application, nvim_host, [
    {description, "Neovim Erlang extension host"},
    {vsn, "0.1.0"},
    {registered, [
        nvim_host_sup,
        nvim_host_connection
    ]},
    {mod, {nvim_host_app, []}},
    {applications, [
        kernel,
        stdlib,
        nvim_rpc
    ]},
    {env, [
        {transport, stdio}
    ]},
    {modules, []},
    {links, []}
]}.
