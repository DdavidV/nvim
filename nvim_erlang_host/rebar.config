{deps, [
    {nvim_rpc, {path, "../nvim_erlang_rpc"}}
]}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_unused_import,
    warn_unused_function,
    warn_shadow_vars,
    warn_export_all,
    warn_obsolete_guard,
    warn_untyped_record
]}.

{alias, [
    {test, [
        {cover, "--reset"},
        {eunit, ["--verbose"]},
        {cover, "-v"}
    ]},
    {flint, [
        {fmt, ["-w"]},
        lint
    ]}
]}.

{plugins, [
    rebar3_path_deps,
    {rebar3_lint, "6.0.0"},
    {erlfmt, "1.8.0"}
]}.

{cover_enabled, true}.

{shell, [
    {apps, [nvim_erlang_host]}
]}.
