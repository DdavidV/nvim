{deps, []}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_unused_import,
    warn_unused_function,
    warn_shadow_vars,
    warn_export_all,
    warn_obsolete_guard
]}.

{alias, [
    {test, [
        {cover, "--reset"},
        eunit,
        {cover, "-v"}
    ]},
    {flint, [
        {fmt, ["-w"]},
        lint
    ]}
]}.

{plugins, [
    {rebar3_lint, "6.0.0"},
    {erlfmt, "1.8.0"}
]}.

{cover_enabled, true}.
